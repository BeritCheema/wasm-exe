+    for (U16 discard : { (U16)0, (U16)16, (U16)0x8000 }) {
+        std::vector<U8> code = {
+            0xEB, 0x03, // jump over return instruction to call
+            0xC2, (U8)discard, (U8)(discard >> 8),
+            0xE8, 0xF8, 0xFF, 0xFF, 0xFF // call offset 2
+        };
+        runAndCheck(r, "ret imm16 stack adjustment", withExit(code), [discard](CPU64& c) {
+            return c.reg[X64_RSP].u64 == STACK_TOP - 16 + discard;
+        });
+    }
