 // no glemu equivalent — Emscripten's FFP shader synthesis already folds glColor
 // into the material, so a no-op preserves the visible result. These shims keep
 // the bridge's call sites (GL_MT(glLightf(...)) etc.) unchanged.
+// glemu's directional-light shader already has the GL default attenuation
+// (1,0,0) and no spotlight. Accept explicit resets to those defaults without
+// entering glemu's abort-only cases. Non-default requests still reach glemu,
+// so unsupported lighting is never silently reported as implemented.
+static inline void bw_glLightfv(GLenum light, GLenum pname, const GLfloat* p) {
+    if ((pname == 0x1207 && p[0] == 1.0f) ||
+        ((pname == 0x1208 || pname == 0x1209 || pname == 0x1205) && p[0] == 0.0f) ||
+        (pname == 0x1206 && p[0] == 180.0f) ||
+        (pname == 0x1204) /* direction is immaterial while cutoff stays 180 */) return;
+    glLightfv(light, pname, p);
+}
